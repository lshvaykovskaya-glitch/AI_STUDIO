{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "rootDir": "./core/src",
    "outDir": "./dist",

    "strict": true,

    "declaration": true,
    "sourceMap": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": false,

    "types": [
      "node"
    ],

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "core/src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
